{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preflight.dev/schemas/action-passport/v1.0",
  "title": "Preflight Action Passport v1.0",
  "description": "A cryptographically signed, tamper-evident audit artifact that records the complete lifecycle of an AI agent action. Designed for court-admissible evidence, regulatory compliance, and enterprise security review.",
  "type": "object",
  "required": [
    "passport_version",
    "passport_id",
    "timestamp",
    "agent",
    "action",
    "risk_assessment",
    "verdict",
    "execution",
    "signatures",
    "chain"
  ],
  "properties": {
    "passport_version": {
      "type": "string",
      "const": "1.0",
      "description": "Action Passport specification version"
    },
    "passport_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique passport identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of passport creation (UTC)"
    },
    "agent": {
      "type": "object",
      "required": ["agent_id", "framework"],
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "Unique identifier for the AI agent"
        },
        "framework": {
          "type": "string",
          "enum": ["openai", "anthropic", "langchain", "crewai", "autogen", "openclaw", "custom"],
          "description": "AI framework that initiated the action"
        },
        "model": {
          "type": "string",
          "description": "Model identifier (e.g., gpt-4, claude-3)"
        },
        "session_id": {
          "type": "string",
          "description": "Session or conversation identifier"
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["tool_name", "action_type", "arguments"],
      "properties": {
        "tool_name": {
          "type": "string",
          "description": "Name of the tool or function being called"
        },
        "action_type": {
          "type": "string",
          "enum": ["read", "write", "delete", "execute", "network", "financial", "admin"],
          "description": "Classification of the action type"
        },
        "arguments": {
          "type": "object",
          "description": "Arguments passed to the tool"
        },
        "target_resources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Resources affected by this action"
        },
        "intent": {
          "type": "object",
          "properties": {
            "goal": { "type": "string" },
            "reasoning_summary": { "type": "string" },
            "expected_state_changes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "reversible": { "type": "boolean" },
            "estimated_cost": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "required": ["composite_score", "components"],
      "properties": {
        "composite_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall risk score (0 = safe, 1 = critical)"
        },
        "components": {
          "type": "object",
          "description": "Individual risk component scores",
          "properties": {
            "tool_risk": { "type": "number" },
            "argument_risk": { "type": "number" },
            "resource_risk": { "type": "number" },
            "cost_risk": { "type": "number" },
            "irreversibility_risk": { "type": "number" },
            "drift_risk": { "type": "number" }
          }
        },
        "simulation": {
          "type": "object",
          "description": "Monte Carlo simulation results",
          "properties": {
            "rollouts": { "type": "integer" },
            "failure_rate": { "type": "number" },
            "confidence_interval": {
              "type": "object",
              "properties": {
                "lower": { "type": "number" },
                "upper": { "type": "number" },
                "method": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["decision", "reason"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "warn", "block", "escalate"],
          "description": "Preflight's decision on the action"
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation"
        },
        "policy_references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Policy rules that triggered"
        },
        "consensus": {
          "type": "object",
          "description": "M-of-N operator consensus if required",
          "properties": {
            "required": { "type": "boolean" },
            "threshold": { "type": "string" },
            "votes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operator_id": { "type": "string" },
                  "vote": { "type": "string" },
                  "timestamp": { "type": "string" },
                  "signature": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["pre_state_hash", "post_state_hash"],
      "properties": {
        "pre_state_hash": {
          "type": "string",
          "description": "SHA-256 hash of state before execution"
        },
        "post_state_hash": {
          "type": "string",
          "description": "SHA-256 hash of state after execution"
        },
        "state_diff": {
          "type": "object",
          "description": "Deterministic diff of state changes"
        },
        "pipeline_duration_ms": {
          "type": "number",
          "description": "Total Preflight pipeline processing time"
        },
        "sandbox_used": {
          "type": "boolean",
          "description": "Whether action was sandboxed first"
        },
        "rollback_available": {
          "type": "boolean",
          "description": "Whether automatic rollback is possible"
        }
      }
    },
    "signatures": {
      "type": "object",
      "required": ["agent_signature", "policy_signature"],
      "description": "Ed25519 (or HMAC-SHA256 fallback) signatures",
      "properties": {
        "agent_signature": {
          "type": "string",
          "description": "Hex-encoded signature by agent signing key"
        },
        "policy_signature": {
          "type": "string",
          "description": "Hex-encoded signature by policy signing key"
        },
        "operator_signature": {
          "type": "string",
          "description": "Hex-encoded signature by operator (if consensus required)"
        },
        "algorithm": {
          "type": "string",
          "enum": ["Ed25519", "HMAC-SHA256"],
          "description": "Signature algorithm used"
        },
        "key_references": {
          "type": "object",
          "description": "Public key references for verification",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "key_id": { "type": "string" },
              "public_key": { "type": "string" },
              "algorithm": { "type": "string" }
            }
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "required": ["previous_hash", "record_hash"],
      "description": "Append-only chain linking for tamper evidence",
      "properties": {
        "previous_hash": {
          "type": "string",
          "description": "SHA-256 hash of the previous passport in the chain"
        },
        "record_hash": {
          "type": "string",
          "description": "SHA-256 hash of this passport's content"
        },
        "sequence_number": {
          "type": "integer",
          "description": "Monotonically increasing sequence number"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tenant_id": { "type": "string" },
        "environment": {
          "type": "string",
          "enum": ["production", "staging", "development", "testing"]
        },
        "preflight_version": { "type": "string" },
        "extensions": {
          "type": "object",
          "description": "Vendor-specific extensions"
        }
      }
    }
  }
}
